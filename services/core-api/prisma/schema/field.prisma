// SENTINEL Field domain (WP-16, architecture sections 13, 67, 76).
// Owned exclusively by services/core-api/src/modules/field. Service-layer reads
// enforce tenant/site scope on every path.
//
// WP-17A site referential integrity — the split in this file is deliberate:
//
//   LIVE DOMAIN STATE (FieldAssignment, FieldOperativeCurrentState)
//     carries a composite (site_id, organisation_id) relation to Site with
//     onDelete: Restrict. These rows assert something true *right now*, so the
//     site they name must exist and must belong to the same organisation. The
//     reference is composite rather than a plain Site.id FK so the database
//     itself rejects a row that pairs one tenant's organisation with another
//     tenant's site (§62.1 defence in depth).
//
//   HISTORICAL / RELIABILITY ARTEFACTS (FieldOperativeStateHistory,
//   FieldStateUpdateIdempotency, FieldAuditLog, FieldOutbox)
//     deliberately carry NO Site foreign key. Their `site_id` is the site
//     identifier as recorded at the time of the event, and it must stay that
//     way. `Cascade` would let a site's lifecycle erase security history
//     (forbidden by §61); `Restrict` on every one of them would mean a site
//     could never be removed once it had produced a single audit row, which
//     silently invents a Site retirement policy this work package has no
//     mandate to decide. Their integrity comes from the write-time check
//     instead: the service proves the site exists in the organisation BEFORE
//     the transaction that writes the live row, the history row, the audit row
//     and the outbox row together.
//
// See docs/execution/directives/WP-17A-field-site-integrity.md for the locked
// ruling, including the rule that a future Site lifecycle feature must define
// RETIRED/tombstone semantics before any hard delete, and must never cascade
// or rewrite retained Field history to make a deletion possible.

model FieldAssignment {
  id String @id @default(uuid()) @db.Uuid

  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  incidentId String? @map("incident_id") @db.Uuid
  assigneeUserId String @map("assignee_user_id") @db.Text
  assignmentType String @map("assignment_type") @db.Text
  priority String @db.Text
  status String @default("REQUESTED") @db.Text
  deliveryState String @default("REQUESTED") @map("delivery_state") @db.Text
  needToKnowSummary String @map("need_to_know_summary") @db.Text
  idempotencyKey String @map("idempotency_key") @db.Text

  expiresAt DateTime? @map("expires_at") @db.Timestamptz(3)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(3)
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  declinedAt DateTime? @map("declined_at") @db.Timestamptz(3)

  createdByUserId String @map("created_by_user_id") @db.Text
  updatedByUserId String @map("updated_by_user_id") @db.Text
  acceptedByUserId String? @map("accepted_by_user_id") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actionIdempotency FieldAssignmentActionIdempotency[]

  /// WP-17A: composite so the pair must match, not just the site id.
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organisationId, siteId, idempotencyKey], map: "field_assignment_create_idem_key")
  @@index([organisationId, siteId, status], map: "field_assignment_status_idx")
  @@index([organisationId, siteId, assigneeUserId], map: "field_assignment_assignee_idx")
  @@index([incidentId])
  @@map("field_assignments")
}

model FieldAssignmentActionIdempotency {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid
  assignment FieldAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  action String @db.Text
  idempotencyKey String @map("idempotency_key") @db.Text
  actorUserId String @map("actor_user_id") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([assignmentId, action, idempotencyKey], map: "field_assignment_action_idem_key")
  @@index([assignmentId, createdAt], map: "field_assignment_action_created_idx")
  @@map("field_assignment_action_idempotency")
}

model FieldOperativeCurrentState {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  userId String @map("user_id") @db.Text
  deviceId String @map("device_id") @db.Text
  state String @db.Text
  location Json?
  sourceAt DateTime @map("source_at") @db.Timestamptz(3)
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  clientFreshnessMs Int @map("client_freshness_ms")
  authoritativeFreshnessMs Int @map("authoritative_freshness_ms")
  traceId String @map("trace_id") @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// WP-17A: composite so the pair must match, not just the site id.
  site Site @relation(fields: [siteId, organisationId], references: [id, organisationId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([organisationId, siteId, userId], map: "field_current_state_scope_key")
  @@index([organisationId, siteId, state], map: "field_current_state_state_idx")
  @@map("field_operative_current_states")
}

model FieldOperativeStateHistory {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  userId String @map("user_id") @db.Text
  deviceId String @map("device_id") @db.Text
  state String @db.Text
  location Json?
  sourceAt DateTime @map("source_at") @db.Timestamptz(3)
  receivedAt DateTime @map("received_at") @db.Timestamptz(3)
  clientFreshnessMs Int @map("client_freshness_ms")
  authoritativeFreshnessMs Int @map("authoritative_freshness_ms")
  traceId String @map("trace_id") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organisationId, siteId, userId, createdAt], map: "field_state_history_user_created_idx")
  @@map("field_operative_state_history")
}

model FieldStateUpdateIdempotency {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  userId String @map("user_id") @db.Text
  deviceId String @map("device_id") @db.Text
  idempotencyKey String @map("idempotency_key") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organisationId, siteId, userId, deviceId, idempotencyKey], map: "field_state_update_idem_key")
  @@index([organisationId, siteId, userId, createdAt], map: "field_state_update_user_created_idx")
  @@map("field_state_update_idempotency")
}

model FieldAuditLog {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  assignmentId String? @map("assignment_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Text
  kind String @db.Text
  payload Json @default("{}")
  at DateTime @default(now()) @db.Timestamptz(3)

  @@index([organisationId, siteId, at], map: "field_audit_scope_at_idx")
  @@index([assignmentId, at], map: "field_audit_assignment_at_idx")
  @@map("field_audit_log")
}

model FieldOutbox {
  id String @id @default(uuid()) @db.Uuid
  organisationId String @map("organisation_id") @db.Text
  siteId String @map("site_id") @db.Text
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt], map: "field_outbox_publish_idx")
  @@index([organisationId, siteId, createdAt], map: "field_outbox_scope_created_idx")
  @@map("field_outbox")
}

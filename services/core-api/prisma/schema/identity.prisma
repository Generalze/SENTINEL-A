// Identity & Organisation domain (architecture §38, §39.2, §62, §62.1).
// Owned exclusively by WP-03 (services/core-api/src/modules/identity).
// datasource/generator live in base.prisma (multi-file schema) — do not
// duplicate them here.

/// Top-level tenant boundary (§39.2). Every Site, User and downstream
/// domain record is scoped to exactly one Organisation; cross-organisation
/// access is denied by default everywhere in the platform.
model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  sites Site[]
  users User[]
  /// C12-04: organisation-wide Whisper signals (site_id NULL) skip the
  /// composite Site relation entirely under MATCH SIMPLE, so they carry a
  /// direct tenant FK instead.
  whisperSignalVersions WhisperSignalVersion[]
  /// WP-24 back-relation for the direct tenant FK every Device carries.
  /// Required by Prisma for the relation declared in shield.prisma; it adds
  /// no column and no behaviour to Identity.
  devices Device[]

  @@map("organisations")
}

/// A physical/operational site belonging to exactly one Organisation.
///
/// WP-17A: `@@unique([id, organisationId])` is a candidate key that exists so
/// Field live-state tables can reference (site, organisation) as a PAIR rather
/// than referencing `id` alone. A plain FK to `Site.id` would still permit a
/// row claiming `organisation_id = org-A, site_id = site-B` where site-B
/// belongs to org-B; the composite reference makes the database reject that,
/// giving §62.1's tenant boundary a defence below the service layer. `id`
/// remains the primary key and nothing about site identity changes.
///
/// NOTE: this model is WP-03's, and the two back-relations below are required
/// by Prisma for the relations declared in field.prisma. They add no column and
/// no behaviour to Identity.
model Site {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  zones        Zone[]
  userRoles    UserRole[]

  fieldAssignments   FieldAssignment[]
  fieldCurrentStates FieldOperativeCurrentState[]
  incidentFieldMessages IncidentFieldMessage[]
  patrolRoutes PatrolRoute[]
  patrolRuns PatrolRun[]
  fieldOfflineCursors FieldOfflineDeviceCursor[]
  /// WP-21B back-relation. SITE-SCOPED versions only: a Whisper signal with a
  /// NULL site_id is organisation-wide (W21-03/C11-02) and by construction
  /// appears in no site's list, so this is never the set of signals
  /// recognisable AT this site.
  whisperSignalVersions WhisperSignalVersion[]
  /// WP-24 back-relations. Required by Prisma for the composite
  /// (site_id, organisation_id) relations declared in shield.prisma; they add
  /// no column and no behaviour to Identity.
  deviceSiteScopes DeviceSiteScope[]
  deviceBootstrapGrants EnrollmentBootstrapGrant[]
  deviceEnrollmentRequests EnrollmentRequest[]
  /// C16-01: the server-issued custody-regime catalogue is scoped to one site.
  deviceCustodyRegimes DeviceCustodyRegime[]
  /// WP-25 back-relations. Required by Prisma for the composite
  /// (site_id, organisation_id) relations declared in device-gateway.prisma;
  /// they add no column and no behaviour to Identity. Neither is authority: a
  /// site named by a device context grants nothing, and every site question is
  /// still answered from current entitlement.
  deviceContextEstablishmentChallenges DeviceContextEstablishmentChallenge[]
  authenticatedDeviceContextSites AuthenticatedDeviceContextSite[]
  /// WP-26 back-relation. Required by Prisma for the composite
  /// (site_id, organisation_id) relation declared in device-enrollment.prisma;
  /// it adds no column and no behaviour to Identity. An attestation challenge
  /// naming a site grants nothing at that site (D26-04A): it is a freshness
  /// value bound to a ceremony, not a scope statement.
  deviceAttestationChallenges DeviceAttestationChallenge[]

  @@unique([id, organisationId], map: "sites_id_organisation_key")
  @@index([organisationId])
  @@map("sites")
}

/// A Zone belongs to one Site. The full digital twin (buildings, floors,
/// routes, devices) is §38's Site & Asset domain; Identity only owns this
/// minimal shell, enough for role site-scoping and WP-03's seed fixtures.
model Zone {
  id        String   @id @default(cuid())
  siteId    String   @map("site_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  site Site @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@map("zones")
}

/// A User belongs to exactly one Organisation. `clearance` (0-5) is
/// compared against a resource's classification level (architecture §47)
/// in the §62.1 access guard: ALLOW requires clearance >= classification.
/// The 0-5 range is enforced at the application layer (zod on the create
/// DTO), not by a DB check constraint.
model User {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  email          String
  displayName    String   @map("display_name")
  clearance      Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  roles        UserRole[]

  /// WP-24 back-relations. Required by Prisma for the composite
  /// (user_id, organisation_id) relations declared in shield.prisma; they add
  /// no column and no behaviour to Identity. Every one of them is device
  /// PROVENANCE — being named on a device grants nothing (D24-02, C14-02).
  devicesEnrolled Device[] @relation("DeviceEnrolledByUser")
  devicesIntendedFor Device[] @relation("DeviceIntendedUser")
  deviceSiteScopes DeviceSiteScope[]
  deviceBootstrapGrantsIssued EnrollmentBootstrapGrant[] @relation("BootstrapGrantIssuedByUser")
  deviceBootstrapGrantsIntendedFor EnrollmentBootstrapGrant[] @relation("BootstrapGrantIntendedUser")
  deviceEnrollmentRequests EnrollmentRequest[]
  deviceEnrollmentApprovals EnrollmentApproval[]
  /// C16-01: the human who DEFINED a custody regime. Provenance, never
  /// authority — naming a regime grants nothing over any device under it.
  deviceCustodyRegimesDefined DeviceCustodyRegime[]

  /// WP-25 back-relations. Required by Prisma for the composite
  /// (actor_user_id, organisation_id) relations declared in
  /// device-gateway.prisma; they add no column and no behaviour to Identity.
  /// Both are BINDINGS, NEVER GRANTS (C14-02/D25-01): being named on an
  /// establishment challenge or an issued device context confers no site
  /// scope, no action and no device authority. Every authorisation is still
  /// answered from the current authenticated principal and their current
  /// entitlement, re-read on every request.
  deviceContextEstablishmentChallenges DeviceContextEstablishmentChallenge[]
  authenticatedDeviceContexts AuthenticatedDeviceContextRecord[]

  /// WP-26 back-relation. Required by Prisma for the composite
  /// (intended_user_id, organisation_id) relation declared in
  /// device-enrollment.prisma; it adds no column and no behaviour to Identity.
  /// It is enrollment PROVENANCE, never authority: being the intended user of
  /// an attestation challenge confers no device, no site scope and no action.
  deviceAttestationChallenges DeviceAttestationChallenge[] @relation("AttestationChallengeIntendedUser")

  @@unique([organisationId, email])
  /// WP-24 / D24-04a: a candidate key, deliberately redundant with the primary
  /// key, added for exactly the reason `sites_id_organisation_key` was added by
  /// WP-17A. It exists so the device tables can reference the (user,
  /// organisation) PAIR rather than referencing `id` alone. A plain FK to
  /// `User.id` would still permit a row claiming `organisation_id = org-A,
  /// intended_user_id = user-B` where user-B belongs to org-B; the composite
  /// reference makes the DATABASE reject that, giving section 62.1's tenant
  /// boundary a defence below the service layer. It introduces no column,
  /// alters no existing constraint and changes no behaviour: `id` remains the
  /// primary key and nothing about user identity changes.
  @@unique([id, organisationId], map: "users_id_organisation_key")
  @@index([organisationId])
  @@map("users")
}

/// A User's assignment to one §62 role string, optionally scoped to a
/// single Site. `siteId = null` means the assignment is organisation-wide
/// (see §62.1's "site scope matches ... when the role assignment is
/// site-scoped" conjunct — a null-scoped assignment always satisfies it).
/// A user may hold several roles, and the same role at multiple sites.
///
/// NOTE: Postgres treats NULL as distinct in unique indexes, so
/// `[userId, role, siteId]` does not de-duplicate organisation-wide
/// (siteId null) rows at the DB level. seed.ts therefore upserts by this
/// model's primary `id` (deterministic per seed user+role) rather than
/// relying on this constraint for idempotency.
model UserRole {
  id     String  @id @default(cuid())
  userId String  @map("user_id")
  role   String
  siteId String? @map("site_id")

  user User  @relation(fields: [userId], references: [id])
  site Site? @relation(fields: [siteId], references: [id])

  @@unique([userId, role, siteId])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}
